#!/usr/bin/env bash
# spec — read-only CLI for Socrates spec/task status.
# Re-derives state from filesystem on every invocation. Never mutates files.
set -euo pipefail

SPECS_DIR="${SPECS_DIR:-docs/specs}"

usage() {
  cat <<'EOF'
Usage: spec <command> [options]

Commands:
  status              List non-archived specs with phase and task counts
  tasks               List tasks across non-archived specs
  tasks --status S    Filter tasks by status (draft|approved|closed|cancelled)
  tasks --review      Show only tasks with non-empty <review> blocks
  ready -a ASSIGNEE   Show the unblocked frontier (approved, deps closed)
  dependents ID       Show tasks whose deps reference the given task id
EOF
}

# Extract a YAML frontmatter value by key from a file.
# Prints the trimmed value, or empty string if not found.
fm_value() {
  local file="$1" key="$2"
  local fence=0
  while IFS= read -r line; do
    if [[ "$line" =~ ^---[[:space:]]*$ ]]; then
      fence=$((fence + 1))
      if [[ "$fence" -ge 2 ]]; then return; fi
      continue
    fi
    if [[ "$fence" -eq 1 ]]; then
      case "$line" in
        "${key}:"*)
          local val="${line#"${key}:"}"
          val="${val#"${val%%[![:space:]]*}"}"
          echo "$val"
          return
          ;;
      esac
    fi
  done < "$file"
}

# Extract a YAML list value by key from a file.
# Parses "key: [a, b, c]" and prints one item per line.
# Prints nothing if not found or empty list.
fm_list() {
  local file="$1" key="$2"
  local raw
  raw=$(fm_value "$file" "$key")
  # Strip brackets
  raw="${raw#\[}"
  raw="${raw%\]}"
  # Trim whitespace
  raw="${raw#"${raw%%[![:space:]]*}"}"
  raw="${raw%"${raw##*[![:space:]]}"}"
  [[ -z "$raw" ]] && return
  # Split on commas
  local IFS=','
  for item in $raw; do
    # Trim whitespace from each item
    item="${item#"${item%%[![:space:]]*}"}"
    item="${item%"${item##*[![:space:]]}"}"
    [[ -n "$item" ]] && echo "$item"
  done
}

# Detect the current phase from an _overview.md file.
# Prints "PhaseName [DRAFT]" for an incomplete spec or the final phase name
# when every phase is complete. Bare headings are complete; legacy COMPLETE
# and APPROVED markers are accepted as complete.
detect_phase() {
  local overview="$1"
  local first_draft="" last_phase="Describe"
  local phase_regex='^## (Describe|Diagnose|Delimit|Direction|Design)( \[([A-Z]+)\])?[[:space:]]*$'

  while IFS= read -r line; do
    if [[ "$line" =~ $phase_regex ]]; then
      local name="${BASH_REMATCH[1]}"
      local marker="${BASH_REMATCH[3]:-}"
      last_phase="$name"
      if [[ "$marker" == "DRAFT" && -z "$first_draft" ]]; then
        first_draft="${name} [DRAFT]"
      fi
    fi
  done < "$overview"

  if [[ -n "$first_draft" ]]; then
    echo "$first_draft"
  else
    echo "$last_phase"
  fi
}

# Check whether a task file's <review> block has non-whitespace content.
# Returns 0 (true) if content exists, 1 (false) otherwise.
has_review_content() {
  local file="$1"
  local inside=0
  while IFS= read -r line; do
    if [[ "$inside" -eq 1 ]]; then
      if [[ "$line" == *"</review>"* ]]; then
        local before="${line%%</review>*}"
        if [[ "$before" =~ [^[:space:]] ]]; then
          return 0
        fi
        return 1
      fi
      if [[ "$line" =~ [^[:space:]] ]]; then
        return 0
      fi
    fi
    if [[ "$line" == *"<review>"* ]]; then
      local after="${line#*<review>}"
      if [[ "$after" == *"</review>"* ]]; then
        after="${after%%</review>*}"
        if [[ "$after" =~ [^[:space:]] ]]; then
          return 0
        fi
        return 1
      fi
      inside=1
      if [[ "$after" =~ [^[:space:]] ]]; then
        return 0
      fi
    fi
  done < "$file"
  return 1
}

cmd_status() {
  local found=0
  for spec_dir in "$SPECS_DIR"/*/; do
    [[ -d "$spec_dir" ]] || continue
    local dirname="${spec_dir%/}"
    dirname="${dirname##*/}"
    [[ "$dirname" == "archive" ]] && continue

    local overview="${spec_dir}_overview.md"
    [[ -f "$overview" ]] || continue

    found=1
    local phase delimit_approved
    phase=$(detect_phase "$overview")
    delimit_approved=$(fm_value "$overview" "delimit_approved")
    if [[ "$delimit_approved" == "true" ]]; then
      delimit_approved="approved"
    else
      delimit_approved="-"
    fi

    local draft=0 approved=0 closed=0
    for task_file in "$spec_dir"/[0-9]*-*.md; do
      [[ -f "$task_file" ]] || continue
      local status
      status=$(fm_value "$task_file" "status")
      case "$status" in
        draft)    draft=$((draft + 1)) ;;
        approved) approved=$((approved + 1)) ;;
        closed)   closed=$((closed + 1)) ;;
      esac
    done

    echo "$dirname"
    echo "  Phase:    $phase"
    echo "  Delimit:  $delimit_approved"
    echo "  Tasks:    ${draft} draft, ${approved} approved, ${closed} closed"
    echo
  done

  if [[ "$found" -eq 0 ]]; then
    echo "No non-archived specs found."
  fi
}

cmd_tasks() {
  local filter_status="" filter_review=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --status)
        if [[ $# -lt 2 ]]; then
          echo "Error: --status requires a value" >&2
          exit 1
        fi
        filter_status="$2"
        shift 2
        ;;
      --review)
        filter_review=1
        shift
        ;;
      *)
        echo "Error: unknown option: $1" >&2
        exit 1
        ;;
    esac
  done

  printf "%-30s %-35s %-10s %-4s %-12s %-10s %s\n" \
    "SPEC" "TASK" "STATUS" "PRI" "CATEGORY" "ASSIGNEE" "REVIEW"

  for spec_dir in "$SPECS_DIR"/*/; do
    [[ -d "$spec_dir" ]] || continue
    local dirname="${spec_dir%/}"
    dirname="${dirname##*/}"
    [[ "$dirname" == "archive" ]] && continue

    for task_file in "$spec_dir"/[0-9]*-*.md; do
      [[ -f "$task_file" ]] || continue

      local task_name="${task_file##*/}"
      task_name="${task_name%.md}"
      local status priority category assignee review_status
      status=$(fm_value "$task_file" "status")
      priority=$(fm_value "$task_file" "priority")
      category=$(fm_value "$task_file" "category")
      assignee=$(fm_value "$task_file" "assignee")

      if [[ -z "$assignee" ]]; then
        assignee="-"
      fi

      if has_review_content "$task_file"; then
        review_status="pending"
      else
        review_status="-"
      fi

      if [[ -n "$filter_status" && "$status" != "$filter_status" ]]; then
        continue
      fi
      if [[ "$filter_review" -eq 1 && "$review_status" != "pending" ]]; then
        continue
      fi

      printf "%-30s %-35s %-10s %-4s %-12s %-10s %s\n" \
        "$dirname" "$task_name" "$status" "$priority" "$category" "$assignee" "$review_status"
    done
  done
}

# Collect all task files across non-archived specs.
# Prints absolute paths, one per line.
all_task_files() {
  for spec_dir in "$SPECS_DIR"/*/; do
    [[ -d "$spec_dir" ]] || continue
    local dirname="${spec_dir%/}"
    dirname="${dirname##*/}"
    [[ "$dirname" == "archive" ]] && continue
    for task_file in "$spec_dir"*.md; do
      [[ -f "$task_file" ]] || continue
      local base="${task_file##*/}"
      [[ "$base" == "_overview.md" ]] && continue
      echo "$task_file"
    done
  done | sort -u
}

# Match a dep entry against a task id.
# A dep matches if it equals the full id OR the identity token prefix.
dep_matches() {
  local dep="$1" task_id="$2"
  [[ "$dep" == "$task_id" ]] && return 0
  # Match by identity token (first component after optional ordinal)
  local task_token
  if [[ "$task_id" =~ ^[0-9]+-(.+)$ ]]; then
    task_token="${BASH_REMATCH[1]}"
  else
    task_token="$task_id"
  fi
  # The dep might be the full id or just the token part
  local dep_token
  if [[ "$dep" =~ ^[0-9]+-(.+)$ ]]; then
    dep_token="${BASH_REMATCH[1]}"
  else
    dep_token="$dep"
  fi
  [[ "$dep_token" == "$task_token" ]] && return 0
  [[ "$dep" == "$task_token" ]] && return 0
  [[ "$dep_token" == "$task_id" ]] && return 0
  return 1
}

cmd_ready() {
  local filter_assignee=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -a)
        if [[ $# -lt 2 ]]; then
          echo "Error: -a requires a value" >&2
          exit 1
        fi
        filter_assignee="$2"
        shift 2
        ;;
      *)
        echo "Error: unknown option: $1" >&2
        exit 1
        ;;
    esac
  done

  if [[ -z "$filter_assignee" ]]; then
    echo "Error: -a ASSIGNEE is required" >&2
    exit 1
  fi

  # Phase 1: collect all tasks with their metadata
  declare -A task_status task_assignee task_priority task_spec
  declare -a task_ids=()
  # deps stored as space-separated strings keyed by task id
  declare -A task_deps

  while IFS= read -r task_file; do
    local tid tstatus tassignee tpriority
    tid=$(fm_value "$task_file" "id")
    [[ -z "$tid" ]] && continue
    tstatus=$(fm_value "$task_file" "status")
    tassignee=$(fm_value "$task_file" "assignee")
    tpriority=$(fm_value "$task_file" "priority")

    task_ids+=("$tid")
    task_status["$tid"]="$tstatus"
    task_assignee["$tid"]="$tassignee"
    task_priority["$tid"]="${tpriority:-9}"

    # Parse spec dirname
    local dir="${task_file%/*}"
    dir="${dir##*/}"
    task_spec["$tid"]="$dir"

    # Collect deps
    local deps_str=""
    while IFS= read -r dep; do
      deps_str="${deps_str:+$deps_str }$dep"
    done < <(fm_list "$task_file" "deps")
    task_deps["$tid"]="$deps_str"
  done < <(all_task_files)

  # Phase 2: detect cycles via topological sort (Kahn's algorithm)
  declare -A in_degree
  declare -A adj  # adjacency: dep -> dependents (space-separated)
  for tid in "${task_ids[@]}"; do
    in_degree["$tid"]=0
  done
  for tid in "${task_ids[@]}"; do
    local deps="${task_deps[$tid]:-}"
    [[ -z "$deps" ]] && continue
    local count=0
    for dep in $deps; do
      # Resolve dep to actual task id
      for other in "${task_ids[@]}"; do
        if dep_matches "$dep" "$other"; then
          count=$((count + 1))
          adj["$other"]="${adj[$other]:+${adj[$other]} }$tid"
          break
        fi
      done
    done
    in_degree["$tid"]=$count
  done

  # Kahn's: process nodes with in_degree 0
  local queue=() sorted=()
  for tid in "${task_ids[@]}"; do
    [[ "${in_degree[$tid]}" -eq 0 ]] && queue+=("$tid")
  done

  while [[ ${#queue[@]} -gt 0 ]]; do
    # Pick the first from queue
    local current="${queue[0]}"
    queue=("${queue[@]:1}")
    sorted+=("$current")

    local neighbors="${adj[$current]:-}"
    for neighbor in $neighbors; do
      in_degree["$neighbor"]=$((${in_degree[$neighbor]} - 1))
      [[ "${in_degree[$neighbor]}" -eq 0 ]] && queue+=("$neighbor")
    done
  done

  if [[ ${#sorted[@]} -ne ${#task_ids[@]} ]]; then
    # Cycle detected — find the tasks still with in_degree > 0
    local cycle_members=""
    for tid in "${task_ids[@]}"; do
      if [[ "${in_degree[$tid]}" -gt 0 ]]; then
        cycle_members="${cycle_members:+$cycle_members, }$tid"
      fi
    done
    echo "Error: dependency cycle detected among: $cycle_members" >&2
    exit 1
  fi

  # Phase 3: filter the frontier — approved, assigned, all deps closed
  local found=0
  for tid in "${sorted[@]}"; do
    [[ "${task_status[$tid]}" != "approved" ]] && continue
    [[ "${task_assignee[$tid]}" != "$filter_assignee" ]] && continue

    # Check all deps are closed
    local blocked=0
    local deps="${task_deps[$tid]:-}"
    if [[ -n "$deps" ]]; then
      for dep in $deps; do
        for other in "${task_ids[@]}"; do
          if dep_matches "$dep" "$other"; then
            if [[ "${task_status[$other]}" != "closed" ]]; then
              blocked=1
            fi
            break
          fi
        done
        [[ "$blocked" -eq 1 ]] && break
      done
    fi
    [[ "$blocked" -eq 1 ]] && continue

    found=1
    local spec="${task_spec[$tid]}"
    local pri="${task_priority[$tid]}"
    echo "${spec}  ${tid}  P${pri}"
  done

  if [[ "$found" -eq 0 ]]; then
    return 0
  fi
}

cmd_dependents() {
  if [[ $# -lt 1 ]]; then
    echo "Error: task id required" >&2
    exit 1
  fi
  local target_id="$1"

  local found=0
  while IFS= read -r task_file; do
    local tid
    tid=$(fm_value "$task_file" "id")
    [[ -z "$tid" ]] && continue

    while IFS= read -r dep; do
      if dep_matches "$dep" "$target_id"; then
        found=1
        local dir="${task_file%/*}"
        dir="${dir##*/}"
        echo "${dir}  ${tid}"
        break
      fi
    done < <(fm_list "$task_file" "deps")
  done < <(all_task_files)
}

case "${1:-}" in
  status)
    cmd_status
    ;;
  tasks)
    shift
    cmd_tasks "$@"
    ;;
  ready)
    shift
    cmd_ready "$@"
    ;;
  dependents)
    shift
    cmd_dependents "$@"
    ;;
  *)
    usage
    ;;
esac
